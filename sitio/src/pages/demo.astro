        item.append(k, t);
        cap.append(item);
      }
      drawWindows(mine, m);
      const verdict = document.createElement("p");
      const chance = c.todas.p < 0.05
        ? `Un resultado tan desigual difícilmente es azar (p = ${c.todas.p.toFixed(2).replace(".", ",")}): ${c.veredicto}.`
        : `Un resultado así puede salir por azar (p = ${c.todas.p.toFixed(2).replace(".", ",")}): sin diferencia clara.`;
      verdict.textContent =
        `${name[0].toUpperCase() + name.slice(1)}, ganó ${c.todas.gana} de ${c.todas.n} ventanas y perdió ${c.todas.pierde}. ${chance}`;
      box.append(verdict);

      const grid = document.createElement("div");
      grid.className = "veredictos";
      for (const k of reg.candidatos) {
        const v = mine.candidatos[k];
        const card = document.createElement("button");
        card.type = "button";
        card.className = "veredicto";
        card.setAttribute("aria-pressed", String(k === m));
        card.style.setProperty("--reg-color", regColor(k));
        card.innerHTML = `<span class="m"></span><span class="cod"></span><span class="v"></span><span class="l"></span><span class="l"></span>`;
        const [title, code, badge, l1, l2] = card.children as unknown as HTMLElement[];
        title.textContent = REG_SHORT[k] ?? k;
        code.textContent = k;
        badge.textContent = v.veredicto;
        badge.classList.add(VEREDICTO[v.veredicto] ?? "neutro");
        const typical = (x: number | null) =>
          x == null ? "" : `; en la ventana típica, la pérdida P80 ${x < 0 ? "baja" : "sube"} ${pct(Math.abs(x)).replace("+", "")}`;
        l1.textContent = `Gana ${v.todas.gana} de ${v.todas.n} ventanas${typical(v.todas.mediana)}.`;
        l2.textContent = `Invierno (may–sep): gana ${v.invierno.gana} de ${v.invierno.n}.`;
        card.addEventListener("click", () => {
          activeReg = k;
          if (k !== btReg) { btReg = k; btSel = -1; }
          render();
        });
        grid.append(card);
      }
      box.append(grid);
      const note = document.createElement("p");
      note.className = "nota";
      note.textContent =
        "Toca una tarjeta para ver ese regresor. p es la probabilidad de un resultado tan desigual solo por azar " +
        "(prueba de signos): bajo 0,05 el veredicto es «mejora» o «empeora»; si no, «sin diferencia clara».";
      box.append(note);
      const cmd = document.createElement("div");
      cmd.className = "comando";
      cmd.innerHTML = "<code></code>";
      (cmd.firstChild as HTMLElement).textContent = cmdFor(m);
      box.append(cmd);
    }
    if (mine?.resumen) loadBacktest(mine);
    else $("btr").hidden = true;
    const tally = reg.candidatos.map((m) => {
      const v = reg!.establecimientos.map((e) => e.candidatos[m]?.veredicto);
      const k = (x: string) => v.filter((y) => y === x).length;
      return `${m}: mejora en ${k("mejora")}, empeora en ${k("empeora")}, sin diferencia clara en ${k("sin diferencia clara")}`;
    });
    $("reg-red").textContent =
      `En los ${reg.establecimientos.length} establecimientos con más atenciones. ${tally.join("; ")}. ` +
      `Con tantos establecimientos, cerca de uno de cada veinte sale "mejora" o "empeora" solo por azar: ` +
      `un regresor útil debería mejorar en muchos, no en unos pocos.`;
  }

  // --- Why a narrower band can be worse: the regressor backtest, week by week ---
  const REG_SHORT: Record<string, string> = {
    ArmónicoFeriados: "Feriados",
    ArmónicoFluNet: "Virus respiratorios",
    ArmónicoFluNetProy: "Virus proyectados",
  };
  const btCache = new Map<string, BtDetail | null>();
  let btReg = "ArmónicoFluNet";
  let btSel = -1; // selected window; -1 = pick the most telling one
  let btFor = "";
  const dec = (v: number) => (Math.round(v * 10) / 10).toFixed(1).replace(".", ",");
  const lossAt = (y: number, q: number) => (y > q ? 0.8 * (y - q) : 0.2 * (q - y));
  const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
  const regLabel = (m: string) => (m === reg?.base ? m : `Armónico ${REG_NAME[m] ?? m}`);
  const regColor = (m: string) => REG_COLOR[m] ?? candColor(reg?.candidatos.indexOf(m) ?? 0);

  type WinStats = {
    wb: number; wr: number; // mean P50-to-P80 width
    sb: number; sr: number; // P80 loss from weeks above the P80 (0.8 per attendance)
    eb: number; er: number; // P80 loss from weeks below the P80 (0.2 per attendance)
    lb: number; lr: number; // P80 loss of the window
    ab: number; ar: number; n: number; // weeks above the P80
    pb: number; pr: number; // mean P80
  };
  function winStats(w: BtWindow, base: string, m: string): WinStats | null {
    const B = w.modelos[base], R = w.modelos[m];
    if (!B || !R) return null;
    const y = w.real;
    const short = (q: number[]) => mean(y.map((v, i) => (v > q[i] ? 0.8 * (v - q[i]) : 0)));
    const excess = (q: number[]) => mean(y.map((v, i) => (v > q[i] ? 0 : 0.2 * (q[i] - v))));
    const s = {
      wb: mean(B[1].map((v, i) => v - B[0][i])), wr: mean(R[1].map((v, i) => v - R[0][i])),
      sb: short(B[1]), sr: short(R[1]), eb: excess(B[1]), er: excess(R[1]),
      ab: y.filter((v, i) => v > B[1][i]).length, ar: y.filter((v, i) => v > R[1][i]).length, n: y.length,
      pb: mean(B[1]), pr: mean(R[1]),
    };
    return { ...s, lb: s.sb + s.eb, lr: s.sr + s.er };
  }
  // the regressor lowered the P80 and lost: the case this section explains
  const lowerWorse = (s: WinStats) => s.pr < s.pb && s.lr > s.lb;

  function defaultWindow(stats: (WinStats | null)[]) {
    // Most telling first: the lower P80 saved on the weeks below it but lost more on the weeks
    // above it; then any lower-and-worse window; then the largest difference.
    const tiers: ((s: WinStats) => boolean)[] = [
      (s) => lowerWorse(s) && s.er < s.eb && s.sr > s.sb,
      lowerWorse,
      () => true,
    ];
    for (const ok of tiers) {
      let best = -1, score = -Infinity;
      stats.forEach((s, i) => {
        if (s && ok(s) && Math.abs(s.lr - s.lb) > score) { best = i; score = Math.abs(s.lr - s.lb); }
      });
      if (best >= 0) return best;
    }
    return -1;
  }

  async function loadBacktest(e: RegEntry) {
    if (!btCache.has(e.c)) {
      let det: BtDetail | null = null;
      try {
        const r = await fetch(BASE + "regresor/" + encodeURIComponent(e.c) + ".json");
        if (r.ok) det = (await r.json()) as BtDetail;
      } catch {
        /* data published before this section existed: the section stays hidden */
      }
      btCache.set(e.c, det);
    }
    if (current?.c !== e.c) return; // another establishment was chosen meanwhile
    const det = btCache.get(e.c);
    if (!det || !e.resumen || !reg) { $("btr").hidden = true; return; }
    if (btFor !== e.c) { btFor = e.c; btSel = -1; }
    $("btr").hidden = false;
    renderBacktest(e, det);
  }

  // "baja de 3,1 a 2,4", "sube de 2,0 a 2,6", "se mantiene en 1,2"
  const change = (a: number, b: number) =>
    dec(a) === dec(b) ? `se mantiene en ${dec(a)}` : `${b < a ? "baja" : "sube"} de ${dec(a)} a ${dec(b)}`;

  function renderBacktest(e: RegEntry, det: BtDetail) {
    const base = reg!.base;
    const cands = reg!.candidatos.filter((m) => e.resumen![m]);
    if (!cands.length || !e.resumen![base]) { $("btr").hidden = true; return; }
    if (!cands.includes(btReg)) btReg = cands.includes("ArmónicoFluNet") ? "ArmónicoFluNet" : cands[0];
    const m = btReg;
    const sel = $("btr-sel");
    sel.innerHTML = "";
    for (const c of cands) {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = REG_SHORT[c] ?? c;
      b.style.setProperty("--reg-color", regColor(c));
      b.setAttribute("aria-pressed", String(c === m));
      b.addEventListener("click", () => { btReg = c; btSel = -1; renderBacktest(e, det); });
      sel.append(b);
    }
    const stats = det.ventanas.map((w) => winStats(w, base, m));
    if (btSel < 0 || !stats[btSel]) btSel = defaultWindow(stats);
    if (btSel < 0) { $("btr").hidden = true; return; }

    const ws = $<HTMLSelectElement>("btr-ventana");
    ws.innerHTML = "";
    det.ventanas.forEach((w, i) => {
      const s = stats[i];
      if (!s) return;
      const tag = lowerWorse(s) ? " · P80 más bajo y peor" : "";
      ws.add(new Option(`${fecha(w.semanas[0])} – ${fecha(w.semanas[w.semanas.length - 1])}${tag}`, String(i)));
    });
    ws.value = String(btSel);
    ws.onchange = () => { btSel = Number(ws.value); renderBacktest(e, det); };

    const cap = $("btr-leyenda");
    cap.style.setProperty("--reg-color", regColor(m));
    cap.innerHTML = "";
    const short = REG_NAME[m] ?? m;
    const items: [string, string][] = [
      ["base", `P80 ${base}`],
      ["conreg", `P80 ${short}`],
      ["conreg-banda", `P50 a P80 ${short}`],
      ["punto ambos", "Bajo ambos P80"],
      ["punto solo-reg", `Sobre el P80 ${short}, bajo el del ${base}`],
      ["punto solo-base", `Sobre el P80 del ${base}, bajo el P80 ${short}`],
      ["punto ambos-corto", "Sobre ambos"],
    ];
    for (const [cls, label] of items) {
      const item = document.createElement("span"); // key and label never split across lines
      item.className = "ley-item";
      const k = document.createElement("span");
      k.className = `ley ${cls}`;
      const t = document.createElement("span");
      t.textContent = label;
      item.append(k, t);
      cap.append(item);
    }

    drawBacktest(det, base, m, (i) => { btSel = i; renderBacktest(e, det); });
    renderWindow(det.ventanas[btSel], stats[btSel]!, base, m);
    // mean P80 shift over the windows where every model forecast (as in the summary table)
    const all = det.ventanas.filter((w) => reg!.candidatos.concat(base).every((c) => !e.resumen![c] || w.modelos[c]));
    const shifts = all.map((w) => winStats(w, base, m)).filter((x): x is WinStats => !!x).map((x) => x.pr - x.pb);
    renderBtSummary(e, base, m, shifts.length ? mean(shifts) : 0);
  }

  const cap = (x: string) => x[0].toUpperCase() + x.slice(1);
  // "su P80 quedó en promedio 7,8 atenciones más abajo"
  const where = (shift: number) =>
    dec(Math.abs(shift)) === "0,0" ? "su P80 quedó prácticamente en el mismo lugar"
      : `su P80 quedó en promedio ${dec(Math.abs(shift))} atenciones más ${shift < 0 ? "abajo" : "arriba"}`;
  // Why the total moved, from its two parts (short: 0.8 per attendance, excess: 0.2).
  function balance(dS: number, dE: number, dT: number) {
    const z = (v: number) => Math.abs(v) < 0.05;
    if (z(dS) || z(dE)) return "";
    if (dS > 0 && dE < 0)
      return dT > 0
        ? ` Se pasó menos (−${dec(-dE)}), pero se quedó corto más (+${dec(dS)}), y quedarse corto cuesta cuatro veces más: en total, peor.`
        : ` Se quedó corto algo más (+${dec(dS)}), pero se pasó bastante menos (−${dec(-dE)}): en total, mejor.`;
    if (dS < 0 && dE > 0)
      return dT > 0
        ? ` Se quedó corto menos (−${dec(-dS)}), pero se pasó más (+${dec(dE)}): en total, peor.`
        : ` Se pasó algo más (+${dec(dE)}), pero se quedó corto menos (−${dec(-dS)}), y eso pesa más: en total, mejor.`;
    return dS > 0 ? " Empeoró en las dos partes." : " Mejoró en las dos partes.";
  }

  function renderWindow(w: BtWindow, s: WinStats, base: string, m: string) {
    const short = REG_NAME[m] ?? m;
    const first = w.semanas[0], last = w.semanas[w.semanas.length - 1];
    const width = s.wb ? pct((100 * (s.wr - s.wb)) / s.wb) : "–";
    const t =
      `Ventana del ${fecha(first)} al ${fecha(last)}. ${cap(short)}, el intervalo P50 a P80 midió ` +
      `${dec(s.wr)} atenciones en promedio, frente a ${dec(s.wb)} del ${base} (${width}), y ${where(s.pr - s.pb)}. ` +
      `Lo real superó su P80 en ${s.ar} de ${s.n} semanas (el del ${base}, en ${s.ab}). ` +
      `La pérdida por pasarse ${change(s.eb, s.er)} y la por quedarse corto ${change(s.sb, s.sr)}: ` +
      `en total ${change(s.lb, s.lr)} (${pct(s.lb ? (100 * (s.lr - s.lb)) / s.lb : null)}).` +
      balance(s.sr - s.sb, s.er - s.eb, s.lr - s.lb);
    $("btr-ej").textContent = t;

    const table = $("btr-semanas");
    table.innerHTML = "";
    const tr = (cells: (string | Node)[], tag = "td", cls = "") => {
      const row = document.createElement("tr");
      if (cls) row.className = cls;
      for (const c of cells) {
        const cell = document.createElement(tag);
        cell.append(c);
        row.append(cell);
      }
      return row;
    };
    const thead = document.createElement("thead");
    thead.append(tr(["Semana", "Real", `P80 ${base}`, "Pérdida", `P80 ${REG_SHORT[m] ?? m}`, "Pérdida"], "th"));
    const tbody = document.createElement("tbody");
    const B = w.modelos[base]!, R = w.modelos[m]!;
    const p80 = (y: number, q: number) => {
      const span = document.createElement("span");
      span.textContent = nf.format(q);
      if (y > q) { span.className = "corto"; span.title = "Lo real superó este P80"; }
      return span;
    };
    const loss = (y: number, q: number) => {
      const frag = document.createDocumentFragment();
      frag.append(dec(lossAt(y, q)));
      const how = document.createElement("span");
      how.className = "cuenta";
      how.textContent = y > q ? `0,8 × ${dec(y - q)}` : `0,2 × ${dec(q - y)}`;
      frag.append(how);
      return frag;
    };
    w.semanas.forEach((d, i) => {
      const y = w.real[i];
      tbody.append(tr([fecha(d), nf.format(y), p80(y, B[1][i]), loss(y, B[1][i]), p80(y, R[1][i]), loss(y, R[1][i])]));
    });
    tbody.append(tr(["Pérdida P80 de la ventana", "", "", dec(s.lb), "", dec(s.lr)], "td", "total"));
    table.append(thead, tbody);
  }

  function renderBtSummary(e: RegEntry, base: string, m: string, shift: number) {
    const R = e.resumen!;
    const b = R[base], r = R[m];
    $("btr-titulo-resumen").textContent = `En las ${b.ventanas} ventanas del backtest`;
    const table = $("btr-resumen");
    table.innerHTML = "";
    const head = document.createElement("thead");
    const hr = document.createElement("tr");
    for (const h of ["Modelo", "Ancho P50 a P80", "Sobre el P80 (se espera 20 %)", "Por quedarse corto (0,8)", "Por pasarse (0,2)", "Pérdida P80"]) {
      const th = document.createElement("th");
      th.textContent = h;
      hr.append(th);
    }
    head.append(hr);
    const body = document.createElement("tbody");
    for (const name of [base, ...reg!.candidatos.filter((c) => R[c])]) {
      const v = R[name];
      const row = document.createElement("tr");
      if (name === m) row.className = "sel";
      for (const c of [regLabel(name), dec(v.ancho), `${Math.round(v.sobre)} %`, dec(v.corto), dec(v.exceso), dec(v.perdida)]) {
        const td = document.createElement("td");
        td.textContent = c;
        row.append(td);
      }
      body.append(row);
    }
    table.append(head, body);
    const short = REG_NAME[m] ?? m;
    const dw = b.ancho ? (100 * (r.ancho - b.ancho)) / b.ancho : 0;
    const t =
      `${cap(short)}, el intervalo P50 a P80 es ${dec(Math.abs(dw))} % ` +
      `${dw < 0 ? "más angosto" : "más ancho"} que el del ${base} y ${where(shift)}. Lo real superó ese P80 en el ` +
      `${Math.round(r.sobre)} % de las semanas (${base}: ${Math.round(b.sobre)} %). ` +
      `La pérdida por pasarse ${change(b.exceso, r.exceso)} y la por quedarse corto ${change(b.corto, r.corto)}: ` +
      `en total ${change(b.perdida, r.perdida)}.` +
      balance(r.corto - b.corto, r.exceso - b.exceso, r.perdida - b.perdida);
    $("btr-texto").textContent = t;
  }

  function drawBacktest(det: BtDetail, base: string, m: string, pick: (i: number) => void) {
    const s = document.getElementById("svg-btr") as unknown as SVGSVGElement;
    const W = Math.max(300, Math.round(s.parentElement!.clientWidth || 760));
    const H = W < 560 ? 220 : 280, mg = { t: 12, r: 10, b: 26, l: 46 };
    s.setAttribute("viewBox", `0 0 ${W} ${H}`);
    s.querySelectorAll(":scope > :not(title)").forEach((n) => n.remove());
    const wk = 7 * 864e5;
    const wins = det.ventanas
      .map((w, i) => ({ i, w, t: w.semanas.map((d) => +new Date(d)), B: w.modelos[base], R: w.modelos[m] }))
      .filter((x): x is { i: number; w: BtWindow; t: number[]; B: [number[], number[]]; R: [number[], number[]] } => !!x.B && !!x.R);
    if (!wins.length) return;
    const vals = wins.flatMap((x) => [...x.w.real, ...x.B[1], ...x.R[1], ...x.R[0]]);
    const lo = Math.min(...vals), hi = Math.max(...vals), pad = (hi - lo) * 0.06 || 1;
    const x0 = wins[0].t[0] - wk, x1 = wins[wins.length - 1].t.slice(-1)[0] + wk;
    const { X, Y } = axes(s, W, H, mg, x0, x1, Math.max(0, lo - pad), hi + pad, (v) => nf.format(v));
    const color = regColor(m);
    const line = (t: number[], v: number[]) => t.map((x, j) => `${j ? "L" : "M"}${X(x).toFixed(1)},${Y(v[j]).toFixed(1)}`).join("");
    const sel = wins.find((x) => x.i === btSel);
    if (sel)
      el("rect", { x: X(sel.t[0] - wk / 2), y: mg.t, width: X(sel.t[sel.t.length - 1] + wk / 2) - X(sel.t[0] - wk / 2),
        height: H - mg.t - mg.b, fill: "var(--sl-color-accent)", "fill-opacity": 0.14 }, s);
    for (const x of wins) {
      const back = x.t.slice().reverse();
      const band = line(x.t, x.R[0]) + back.map((t, j) => `L${X(t).toFixed(1)},${Y(x.R[1][x.t.length - 1 - j]).toFixed(1)}`).join("") + "Z";
      el("path", { d: band, fill: color, "fill-opacity": 0.18 }, s);
      el("path", { d: line(x.t, x.B[1]), fill: "none", stroke: "var(--sl-color-gray-2)", "stroke-width": 1.6, "stroke-dasharray": "4 3" }, s);
      el("path", { d: line(x.t, x.R[1]), fill: "none", stroke: color, "stroke-width": 2 }, s);
    }
    for (const x of wins) {
      x.w.real.forEach((y, j) => {
        const overB = y > x.B[1][j], overR = y > x.R[1][j];
        const attrs: Record<string, string | number> = { cx: X(x.t[j]), cy: Y(y), r: 3.2 };
        if (overB && overR) Object.assign(attrs, { fill: "var(--sl-color-gray-1, var(--sl-color-white))" });
        else if (overR) Object.assign(attrs, { fill: "var(--sl-color-red)", r: 3.6 });
        else if (overB) Object.assign(attrs, { fill: "var(--sl-color-bg)", stroke: color, "stroke-width": 2, r: 3.4 });
        else Object.assign(attrs, { fill: "var(--sl-color-gray-3)", r: 2.4 });
        el("circle", attrs, s);
      });
    }
    for (const x of wins) {
      const hit = el("rect", { x: X(x.t[0] - wk / 2), y: mg.t, width: X(x.t[x.t.length - 1] + wk / 2) - X(x.t[0] - wk / 2),
        height: H - mg.t - mg.b, fill: "transparent", class: "hit" }, s);
      el("title", {}, hit).textContent = `Ventana del ${fecha(x.w.semanas[0])}: ver semana a semana`;
      hit.addEventListener("click", () => pick(x.i));
    }
  }

  // the first day of a month on or after x (labels go on Jan 1 and Jul 1)
  function firstOfMonth(x: number) {
    const d = new Date(x);
    const t = new Date(d.getFullYear(), d.getMonth(), 1);
    if (+t < x) t.setMonth(t.getMonth() + 1);
    return t;
  }

  function axes(s: SVGSVGElement, W: number, H: number, m: { t: number; r: number; b: number; l: number },
                x0: number, x1: number, y0: number, y1: number, fmt: (v: number) => string) {
    const X = (t: number) => m.l + ((t - x0) / (x1 - x0)) * (W - m.l - m.r);
    const Y = (v: number) => H - m.b - ((v - y0) / (y1 - y0)) * (H - m.t - m.b);
    const step = niceStep((y1 - y0) / 4);
    for (let v = Math.ceil(y0 / step) * step; v <= y1 + 1e-9; v += step) {
      el("line", { x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), stroke: "var(--sl-color-hairline)" }, s);
      el("text", { x: m.l - 6, y: Y(v) + 4, "text-anchor": "end" }, s).textContent = fmt(v);
    }
    const narrow = W < 560;
    for (let t = firstOfMonth(x0); +t <= x1; t.setMonth(t.getMonth() + 1)) {
      if (![0, 6].includes(t.getMonth())) continue;
      if (narrow && t.getMonth() !== 0) continue;
      el("text", { x: X(+t), y: H - 8, "text-anchor": "middle" }, s).textContent =
        narrow ? String(t.getFullYear()) : `${MESES[t.getMonth()]} ${t.getFullYear()}`;
    }
    return { X, Y };
  }

  function drawPositivity(r: Reg) {
    const s = document.getElementById("svg-pos") as unknown as SVGSVGElement;
    const W = Math.max(300, Math.round(s.parentElement!.clientWidth || 760));
    const H = W < 560 ? 200 : 240, m = { t: 12, r: 10, b: 26, l: 40 };
    s.setAttribute("viewBox", `0 0 ${W} ${H}`);
    s.querySelectorAll(":scope > :not(title)").forEach((n) => n.remove());
    const pos = r.positividad, pr = r.proyeccion;
    const x0 = +new Date(pos[0][0]), x1 = +new Date(pr[pr.length - 1][0]);
    const hi = Math.max(...pos.map((p) => Math.max(p[1], p[2])), ...pr.map((p) => Math.max(p[1], p[2])));
    const { X, Y } = axes(s, W, H, m, x0, x1, 0, hi * 1.08, (v) => `${v} %`);
    const path = (rows: [number, number][]) => rows.map(([t, v], i) => `${i ? "L" : "M"}${X(t).toFixed(1)},${Y(v).toFixed(1)}`).join("");
    const last = pos[pos.length - 1];
    for (const [i, color] of [[1, "var(--sl-color-blue)"], [2, "var(--sl-color-orange)"]] as [number, string][]) {
      el("path", { d: path(pos.map((p) => [+new Date(p[0]), p[i]])), fill: "none", stroke: color, "stroke-width": 2, "stroke-linejoin": "round" }, s);
      el("path", { d: path([[+new Date(last[0]), last[i]], ...pr.map((p) => [+new Date(p[0]), p[i]] as [number, number])]), fill: "none", stroke: color, "stroke-width": 2, "stroke-dasharray": "4 4" }, s);
    }
    el("line", { x1: X(+new Date(last[0])), x2: X(+new Date(last[0])), y1: m.t, y2: H - m.b, stroke: "var(--sl-color-gray-4)", "stroke-dasharray": "3 4" }, s);
  }

  // One bar per backtest window: how much lower (green, up) or higher (red, down) the P80 loss
  // of Armónico + regressor was than Armónico alone.
  function drawWindows(e: RegEntry, m: string) {
    const s = document.getElementById("svg-reg") as unknown as SVGSVGElement;
    const W = Math.max(300, Math.round(s.parentElement!.clientWidth || 760));
    const H = W < 560 ? 210 : 240, mg = { t: 18, r: 10, b: 26, l: 46 };
    s.setAttribute("viewBox", `0 0 ${W} ${H}`);
    s.setAttribute("aria-label", `Por ventana: cuánto se equivocó menos o más el Armónico ${REG_NAME[m] ?? m} que el Armónico solo`);
    const i = reg!.candidatos.indexOf(m);
    const wk = 7 * 864e5;
    const rows = e.ventanas.map((w) => {
      const v = w[3 + i] as number | null;
      return { t: +new Date(w[0]), winter: w[1], base: w[2], cand: v, gain: v == null || !w[2] ? null : 100 * (1 - v / w[2]) };
    });
    const all = rows.map((r) => r.gain).filter((v): v is number => v != null);
    // true scale up to ±120 %, so the big misses show as big; beyond that, clipped and labelled
    const lim = Math.min(120, Math.max(10, ...all.map(Math.abs)) * 1.1);
    const x0 = rows[0].t, x1 = rows[rows.length - 1].t + 5 * wk;
    const X0 = (t: number) => mg.l + ((t - x0) / (x1 - x0)) * (W - mg.l - mg.r);
    for (const r of rows.filter((r) => r.winter))
      el("rect", { x: X0(r.t + 0.5 * wk), y: mg.t, width: X0(r.t + 4.5 * wk) - X0(r.t + 0.5 * wk), height: H - mg.t - mg.b, fill: "var(--sl-color-gray-3)", "fill-opacity": 0.12 }, s);
    const { X, Y } = axes(s, W, H, mg, x0, x1, -lim, lim, (v) => `${v > 0 ? "+" : ""}${v} %`);
    el("line", { x1: mg.l, x2: W - mg.r, y1: Y(0), y2: Y(0), stroke: "var(--sl-color-gray-3)" }, s);
    el("text", { x: mg.l + 6, y: mg.t - 6 }, s).textContent =
      W < 560 ? "▲ menos error · ▼ más error" : "▲ se equivocó menos con el regresor · ▼ se equivocó más";
    for (const r of rows) {
      if (r.gain == null) continue;
      const g = Math.max(-lim, Math.min(lim, r.gain));
      const xa = X(r.t + 1 * wk), xb = X(r.t + 4 * wk);
      const bar = el("rect", {
        x: xa, width: Math.max(1, xb - xa), y: Math.min(Y(0), Y(g)), height: Math.max(1, Math.abs(Y(g) - Y(0))),
        fill: Math.abs(r.gain) < 0.05 ? "var(--sl-color-gray-3)" : r.gain > 0 ? "var(--sl-color-green)" : "var(--sl-color-red)",
      }, s);
      el("title", {}, bar).textContent =
        `Ventana desde el ${fecha(new Date(r.t + wk).toISOString().slice(0, 10))}: pérdida P80 ` +
        `${dec(r.base)} con el Armónico solo y ${dec(r.cand!)} ${REG_NAME[m] ?? m} ` +
        `(${dec(Math.abs(r.gain))} % ${r.gain > 0 ? "menos" : "más"} error)`;
      if (Math.abs(r.gain) > lim) // clipped: the real value, written inside the end of the bar
        el("text", { x: (xa + xb) / 2, y: r.gain > 0 ? Y(lim) + 11 : Y(-lim) - 5, "text-anchor": "middle", class: "recorte" }, s).textContent =
          `${r.gain > 0 ? "+" : "−"}${Math.round(Math.abs(r.gain))}`;
    }
  }

  const NS = "http://www.w3.org/2000/svg";
  function el(name: string, attrs: Record<string, string | number>, parent: Element = svg) {
    const e = document.createElementNS(NS, name);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    parent.append(e);
    return e;
  }

  // The forecast chart. With ``regName`` it compares Armónico with and without that regressor
  // (both uncalibrated) instead of showing the calibrated forecast.
  function drawChart(d: Detail, fc: Detail["pronostico"], svg: SVGSVGElement, tooltip: HTMLDivElement, regName: string | null) {
    const E = (n: string, a: Record<string, string | number>) => el(n, a, svg);
    const W = Math.max(300, Math.round(svg.parentElement!.clientWidth || 760));
    const narrow = W < 560;
    const H = narrow ? 260 : 320, m = { t: 14, r: 10, b: 26, l: narrow ? 40 : 48 };
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.querySelectorAll(":scope > :not(title)").forEach((n) => n.remove());
    svg.querySelector("title")!.textContent = regName
      ? `Pronóstico del Armónico con y sin el regresor ${REG_NAME[regName] ?? regName}, ${d.n}`
      : `Atenciones semanales y pronóstico a ${horizon} semanas, ${d.n}`;
    const hist = d.historia.slice(-104);
    const pts = [...hist.map((r) => r[0]), ...fc.map((r) => r[0])].map((s) => +new Date(s));
    const x0 = pts[0], x1 = pts[pts.length - 1];
    const regs = d.regresores ?? {};
    const overlay = regName && regs[regName] && regs["Armónico"]
      ? { base: regs["Armónico"].pronostico.slice(0, fc.length), con: regs[regName].pronostico.slice(0, fc.length),
          valores: regs[regName].valores ?? [], columnas: regs[regName].columnas ?? [] }
      : null;
    // y range from what is drawn: the calibrated bands, or both uncalibrated forecasts
    const shown = overlay
      ? [...overlay.base.map((r) => r[1]), ...overlay.con.flatMap((r) => [r[1], r[2]])]
      : fc.flatMap((r) => [r[1], r[3]]);
    const lo = Math.min(...hist.map((r) => r[1]), ...shown);
    const hi = Math.max(...hist.map((r) => r[1]), ...shown);
    const pad = (hi - lo) * 0.08 || 1;
    const y0 = Math.max(0, lo - pad), y1 = hi + pad;
    const X = (t: number) => m.l + ((t - x0) / (x1 - x0)) * (W - m.l - m.r);
    const Y = (v: number) => H - m.b - ((v - y0) / (y1 - y0)) * (H - m.t - m.b);

    // grid + y labels
    const step = niceStep((y1 - y0) / 4);
    for (let v = Math.ceil(y0 / step) * step; v <= y1; v += step) {
      E("line", { x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), stroke: "var(--sl-color-hairline)" });
      E("text", { x: m.l - 6, y: Y(v) + 4, "text-anchor": "end" }).textContent = nf.format(v);
    }
    // x labels: Jan and Jul
    for (let t = firstOfMonth(x0); +t <= x1; t.setMonth(t.getMonth() + 1)) {
      if (![0, 6].includes(t.getMonth())) continue;
      if (narrow && t.getMonth() !== 0) continue;
      const lab = E("text", { x: X(+t), y: H - 8, "text-anchor": "middle" });
      lab.textContent = narrow ? String(t.getFullYear()) : `${MESES[t.getMonth()]} ${t.getFullYear()}`;
    }

    const line = (rows: [number, number][]) => rows.map(([t, v], i) => `${i ? "L" : "M"}${X(t).toFixed(1)},${Y(v).toFixed(1)}`).join("");
    const band = (a: [number, number][], b: [number, number][]) =>
      line(a) + b.slice().reverse().map(([t, v]) => `L${X(t).toFixed(1)},${Y(v).toFixed(1)}`).join("") + "Z";
    const F = fc.map((r) => [+new Date(r[0]), r[1], r[2], r[3]]);
    const lastH: [number, number] = [+new Date(hist[hist.length - 1][0]), hist[hist.length - 1][1]];
    const p50 = [lastH, ...F.map((r) => [r[0], r[1]] as [number, number])];
    if (!overlay) {
      E("path", { d: band(F.map((r) => [r[0], r[1]]), F.map((r) => [r[0], r[3]])), fill: "var(--sl-color-accent)", "fill-opacity": 0.16 });
      E("path", { d: band(F.map((r) => [r[0], r[1]]), F.map((r) => [r[0], r[2]])), fill: "var(--sl-color-accent)", "fill-opacity": 0.32 });
    }
    E("path", { d: line(hist.map((r) => [+new Date(r[0]), r[1]])), fill: "none", stroke: "var(--sl-color-gray-3)", "stroke-width": 1.8, "stroke-linejoin": "round" });
    if (!overlay) E("path", { d: line(p50), fill: "none", stroke: "var(--sl-color-accent)", "stroke-width": 2.6, "stroke-linejoin": "round" });
    if (overlay) {
      const color = REG_COLOR[regName!] ?? "var(--sl-color-accent)";
      const C = overlay.con.map((r) => [+new Date(r[0]), r[1], r[2]] as [number, number, number]);
      const B = overlay.base.map((r) => [+new Date(r[0]), r[1]] as [number, number]);
      E("path", { d: band(C.map((r) => [r[0], r[1]]), C.map((r) => [r[0], r[2]])), fill: color, "fill-opacity": 0.22 });
      E("path", { d: line([lastH, ...B]), fill: "none", stroke: "var(--sl-color-gray-2)", "stroke-width": 2, "stroke-dasharray": "5 4" });
      E("path", { d: line([lastH, ...C.map((r) => [r[0], r[1]] as [number, number])]), fill: "none", stroke: color, "stroke-width": 2.6, "stroke-linejoin": "round" });
      if (regName === "ArmónicoFeriados") {
        // mark forecast weeks with holidays on a weekday
        for (const v of overlay.valores) {
          const n = Number(v[1]);
          if (!n || +new Date(String(v[0])) > x1) continue;
          const x = X(+new Date(String(v[0])));
          E("line", { x1: x, x2: x, y1: H - m.b, y2: H - m.b - 8, stroke: color, "stroke-width": 3 });
          if (!narrow) E("text", { x, y: H - m.b - 11, "text-anchor": "middle" }).textContent = n > 1 ? `${n}F` : "F";
        }
      }
    }
    E("line", { x1: X(lastH[0]), x2: X(lastH[0]), y1: m.t, y2: H - m.b, stroke: "var(--sl-color-gray-4)", "stroke-dasharray": "3 4" });
    E("text", { x: X(lastH[0]) - 6, y: m.t + 10, "text-anchor": "end" }).textContent = "datos hasta acá";

    // hover layer
    const guide = E("line", { y1: m.t, y2: H - m.b, stroke: "var(--sl-color-gray-2)", "stroke-width": 1, visibility: "hidden" });
    const dot = E("circle", { r: 4.5, fill: "var(--sl-color-accent)", stroke: "var(--sl-color-bg)", "stroke-width": 2, visibility: "hidden" });
    const all = [
      ...hist.map((r) => ({ t: +new Date(r[0]), s: r[0], v: r[1], f: null as null | number[] })),
      ...fc.map((r) => ({ t: +new Date(r[0]), s: r[0], v: r[1], f: [r[1], r[2], r[3]] })),
    ];
    const regAt = (s: string) => {
      if (!overlay) return null;
      const b = overlay.base.find((r) => r[0] === s), c = overlay.con.find((r) => r[0] === s);
      const v = overlay.valores.find((r) => r[0] === s);
      return b && c ? { b: b[1], c: c[1], v } : null;
    };
    const hit = E("rect", { x: m.l, y: m.t, width: W - m.l - m.r, height: H - m.t - m.b, fill: "transparent" });
    const move = (ev: PointerEvent) => {
      const box = svg.getBoundingClientRect();
      const sx = ((ev.clientX - box.left) / box.width) * W;
      let best = all[0];
      for (const p of all) if (Math.abs(X(p.t) - sx) < Math.abs(X(best.t) - sx)) best = p;
      const cx = X(best.t), cy = Y(best.v);
      guide.setAttribute("x1", String(cx)); guide.setAttribute("x2", String(cx));
      guide.setAttribute("visibility", "visible");
      const rb = best.f ? regAt(best.s) : null;
      const cyy = rb ? Y(rb.c) : cy;
      dot.setAttribute("cx", String(cx)); dot.setAttribute("cy", String(cyy));
      dot.setAttribute("fill", rb ? (REG_COLOR[regName!] ?? "var(--sl-color-accent)") : best.f ? "var(--sl-color-accent)" : "var(--sl-color-gray-2)");
      dot.setAttribute("visibility", "visible");
      tooltip.innerHTML = "";
      const head = document.createElement("strong");
      head.textContent = `Semana al ${fecha(best.s)}`;
      tooltip.append(head, document.createElement("br"));
      const ra = best.f ? regAt(best.s) : null;
      if (ra) {
        tooltip.append(`Armónico ${nf.format(ra.b)} · ${REG_NAME[regName!]} ${nf.format(ra.c)}`);
        if (ra.v) {
          tooltip.append(document.createElement("br"));
          tooltip.append(
            regName === "ArmónicoFeriados"
              ? `${ra.v[1]} feriado${Number(ra.v[1]) === 1 ? "" : "s"} en día hábil`
              : `Positividad supuesta: influenza ${String(ra.v[1]).replace(".", ",")} %, VRS ${String(ra.v[2]).replace(".", ",")} %`,
          );
        }
      } else {
        tooltip.append(
          best.f
            ? `Pronóstico ${nf.format(best.f[0])} · P80 ${nf.format(best.f[1])} · P95 ${nf.format(best.f[2])}`
            : `${nf.format(best.v)} atenciones`,
        );
      }
      tooltip.hidden = false;
      const px = (cx / W) * box.width;
      tooltip.style.left = `${Math.min(Math.max(px - tooltip.offsetWidth / 2, 0), box.width - tooltip.offsetWidth)}px`;
      tooltip.style.top = `${(cyy / H) * box.height - tooltip.offsetHeight - 14}px`;
    };
    hit.addEventListener("pointermove", move as EventListener);
    hit.addEventListener("pointerleave", () => {
      guide.setAttribute("visibility", "hidden");
      dot.setAttribute("visibility", "hidden");
      tooltip.hidden = true;
    });
  }

  function niceStep(raw: number) {
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    const f = raw / p;
    return (f < 1.5 ? 1 : f < 3.5 ? 2 : f < 7.5 ? 5 : 10) * p;
  }

  document.querySelectorAll<HTMLButtonElement>("#regs button").forEach((b) =>
    b.addEventListener("click", () => {
      activeReg = b.dataset.reg!; // one regressor is always shown
      if (activeReg !== btReg) { btReg = activeReg; btSel = -1; } // the backtest below follows
      render();
    }),
  );
  q.addEventListener("input", renderList);
  q.addEventListener("focus", () => { q.select(); renderList(); });
  q.addEventListener("blur", () => setTimeout(closeList, 200));
  q.addEventListener("keydown", (ev) => {
    if (list.hidden) return;
    if (ev.key === "ArrowDown" || ev.key === "ArrowUp") {
      ev.preventDefault();
      active = Math.max(0, Math.min(shown.length - 1, active + (ev.key === "ArrowDown" ? 1 : -1)));
      list.querySelectorAll("li").forEach((li, i) => li.setAttribute("aria-selected", String(i === active)));
      q.setAttribute("aria-activedescendant", `op-${active}`);
      list.querySelector(`#op-${active}`)?.scrollIntoView({ block: "nearest" });
    } else if (ev.key === "Enter") {
      const e = shown[active] ?? shown.find((x) => x.ok);
      if (e?.ok) select(e);
    } else if (ev.key === "Escape") {
      closeList();
    }
  });
  for (const s of [selTipo, selRegion]) s.addEventListener("change", () => { q.focus(); renderList(); });
  document.querySelectorAll<HTMLButtonElement>(".horizonte button").forEach((b) =>
    b.addEventListener("click", () => {
      horizon = Number(b.dataset.h);
      document.querySelectorAll(".horizonte button").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      render();
    }),
  );
  $("copiar").addEventListener("click", async () => {
    const text = $("cmd").textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      $("copiar").textContent = "Copiado";
    } catch {
      const r = document.createRange();
      r.selectNodeContents($("cmd"));
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(r);
    }
    setTimeout(() => ($("copiar").textContent = "Copiar"), 1500);
  });
  let resizeTimer = 0;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => current && render(), 150);
  });
  window.addEventListener("hashchange", () => {
    const e = entries.find((x) => x.c === decodeURIComponent(location.hash.slice(1)) && x.ok);
    if (e && e.c !== current?.c) select(e);
  });

  init();
</script>
