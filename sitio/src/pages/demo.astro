    display: flex; flex-direction: column; align-items: flex-start; gap: 0.15rem; text-align: left;
    border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; padding: 0.75rem 0.9rem;
    background: transparent; color: inherit; font: inherit; cursor: pointer;
  }
  #demo .veredicto[aria-pressed="true"] { border-color: var(--reg-color); box-shadow: inset 0 0 0 1px var(--reg-color); }
  #demo .veredicto .cod { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); font-family: var(--sl-font-mono); }
  #demo .veredicto .m { font-weight: 600; color: var(--sl-color-white); }
  #demo .veredicto .v { display: inline-block; margin: 0.35rem 0; padding: 0.1rem 0.55rem; border-radius: 999px; font-size: var(--sl-text-sm); font-weight: 600; }
  #demo .v.mejora { background: color-mix(in srgb, var(--sl-color-green) 22%, transparent); color: var(--sl-color-green-high); }
  #demo .v.empeora { background: color-mix(in srgb, var(--sl-color-red) 22%, transparent); color: var(--sl-color-red-high); }
  #demo .v.neutro { background: var(--sl-color-gray-6); color: var(--sl-color-gray-2); }
  #demo .veredicto .l { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); margin: 0; }
  #demo .receta { font-size: var(--sl-text-xs); overflow-x: auto; padding: 0.75rem 0.9rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; background: var(--sl-color-gray-7, var(--sl-color-bg-nav)); }
  #demo .receta code { font-size: inherit; white-space: pre; }
</style>

<script>
  type Entry = { c: string; n: string; t: string; r: string; k: string; s: string; ok: boolean; motivo?: string; m?: string; u?: string };
  type Detail = Entry & {
    historia: [string, number][];
    pronostico: [string, number, number, number][];
    // p50, p90, p95, media and wis: backtest score of each --criterio (data from 2026-11 on)
    backtest: ({ modelo: string; mae: number; mape: number | null; p80: number } & Partial<Record<string, number>>)[];
    mejor: string;
    cobertura: [number, number];
    ventanas: number;
    semanas_backtest: number;
    regresores?: Record<string, { pronostico: [string, number, number][]; valores?: (string | number)[][]; columnas?: string[] }>;
    analisis?: {
      nivel: number; cambio_nivel: number | null; interanual: number | null; amplitud: number;
      alta: [number, string]; baja: [number, string];
      anual: [number, number, number, number | null][];
      tipico: [number, number, number, number, number | null][];
      anio: number; actual: [number, number][];
    };
  };

  type RegStats = { n: number; gana: number; pierde: number; p: number; mediana: number | null; total: number | null };
  type RegCand = { veredicto: string; todas: RegStats; invierno: RegStats; resto: RegStats };
  type RegSummary = { ventanas: number; ancho: number; sobre: number; corto: number; exceso: number; perdida: number };
  type RegEntry = {
    c: string; n: string; candidatos: Record<string, RegCand>; ventanas: [string, boolean, number, ...(number | null)[]][];
    resumen?: Record<string, RegSummary>;
  };
  // demo/regresor/<code>.json: every backtest window, what happened and each model's P50 and P80
  type BtWindow = { origen: string; semanas: string[]; real: number[]; modelos: Record<string, [number[], number[]] | null> };
  type BtDetail = { c: string; n: string; ventanas: BtWindow[] };
  type Reg = {
    base: string; candidatos: string[]; horizonte: number; ventanas: number; paso: number; flunet_hasta: string;
    positividad: [string, number, number][]; proyeccion: [string, number, number][]; establecimientos: RegEntry[];
  };
  let reg: Reg | null = null;
  let meta: { ultima_fecha: string; version?: string } | null = null;
  let HORIZON_CALC = 26; // horizon the demo forecasts were computed with (indice.json)
  let activeReg: string | null = null;

  const root = document.getElementById("demo")!;
  const BASE = root.dataset.base + "datos/demo/";
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>("q");
  const list = $<HTMLUListElement>("resultados");
  const selTipo = $<HTMLSelectElement>("tipo");
  const selRegion = $<HTMLSelectElement>("region");
  const estado = $<HTMLParagraphElement>("estado");
  const ficha = $<HTMLElement>("ficha");
  const svg = document.getElementById("svg") as unknown as SVGSVGElement;
  const tooltip = $<HTMLDivElement>("tooltip");
  const svgReg = document.getElementById("svg-regfc") as unknown as SVGSVGElement;
  const tooltipReg = $<HTMLDivElement>("tooltip-reg");

  const nf = new Intl.NumberFormat("es-CL", { maximumFractionDigits: 0 });
  const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
  const fecha = (s: string) => {
    const [y, m, d] = s.split("-").map(Number);
    return `${d} ${MESES[m - 1]} ${y}`;
  };
  const fold = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  let entries: Entry[] = [];
  let current: Detail | null = null;
  let horizon = 26;
  let active = -1;
  let shown: Entry[] = [];

  async function init() {
    let idx;
    try {
      const r = await fetch(BASE + "indice.json");
      if (!r.ok) throw new Error(String(r.status));
      idx = await r.json();
    } catch {
      estado.textContent =
        "Los datos de la demo todavía no están disponibles. Se generan cada semana desde el DEIS.";
      return;
    }
    entries = idx.establecimientos;
    meta = idx.meta;
    HORIZON_CALC = idx.horizonte ?? 26;
    const ok = entries.filter((e) => e.ok).length;
    estado.textContent = `${nf.format(ok)} establecimientos con pronóstico · datos DEIS hasta el ${fecha(idx.meta.ultima_fecha)}`;
    for (const t of [...new Set(entries.map((e) => e.t).filter(Boolean))].sort())
      selTipo.add(new Option(t, t));
    for (const r of [...new Set(entries.map((e) => e.r).filter(Boolean))].sort())
      selRegion.add(new Option(r.replace(/^De(l)? /, ""), r));
    const wanted = decodeURIComponent(location.hash.slice(1)) || "24-105";
    const first = entries.find((e) => e.c === wanted && e.ok) || entries.find((e) => e.ok);
    if (first) select(first);
    try {
      const r = await fetch(BASE + "regresor.json");
      if (r.ok) reg = (await r.json()) as Reg;
    } catch {
      /* the regressor example is optional; the forecast works without it */
    }
    if (current) render();
  }

  function filtered(): Entry[] {
    const terms = fold(q.value).split(/\s+/).filter(Boolean);
    return entries.filter((e) => {
      if (selTipo.value && e.t !== selTipo.value) return false;
      if (selRegion.value && e.r !== selRegion.value) return false;
      const hay = fold(`${e.n} ${e.c} ${e.k} ${e.t} ${e.r} ${e.s}`);
      return terms.every((t) => hay.includes(t));
    });
  }

  function renderList() {
    shown = filtered().slice(0, 60);
    list.innerHTML = "";
    if (!shown.length) {
      const li = document.createElement("li");
      li.textContent = "Sin coincidencias";
      li.className = "sin";
      list.append(li);
    }
    shown.forEach((e, i) => {
      const li = document.createElement("li");
      li.id = `op-${i}`;
      li.setAttribute("role", "option");
      li.className = e.ok ? "" : "sin";
      li.innerHTML = `<span></span><span class="meta"></span>`;
      (li.firstChild as HTMLElement).textContent = e.n;
      (li.lastChild as HTMLElement).textContent = e.ok
        ? `${e.t} · ${e.k || e.c}`
        : `sin pronóstico: ${e.motivo ?? ""}`;
      // pointerdown keeps focus in the input (so blur doesn't close the list first);
      // click does the selection, which also works for touch and assistive tech.
      li.addEventListener("pointerdown", (ev) => ev.preventDefault());
      li.addEventListener("mousedown", (ev) => ev.preventDefault());
      li.addEventListener("click", () => {
        if (e.ok) select(e);
      });
      list.append(li);
    });
    active = -1;
    list.hidden = false;
    q.setAttribute("aria-expanded", "true");
  }

  function closeList() {
    list.hidden = true;
    q.setAttribute("aria-expanded", "false");
  }

  async function select(e: Entry) {
    closeList();
    q.value = e.n;
    try {
      history.replaceState(null, "", "#" + e.c);
    } catch {
      /* some embedded viewers forbid URL changes; the link just won't update */
    }
    try {
      const r = await fetch(BASE + e.c + ".json");
      if (!r.ok) throw new Error(String(r.status));
      current = (await r.json()) as Detail;
    } catch (err) {
      estado.textContent = `No se pudo cargar ${e.n} (${err}). Intenta de nuevo.`;
      return;
    }
    ficha.hidden = false;
    render();
  }

  function render() {
    if (!current) return;
    const d = current;
    $("nombre").textContent = d.n;
    $("detalle").textContent = [d.t, d.k, d.r?.replace(/^De(l)? /, "Región de "), d.s, `código ${d.c}`]
      .filter(Boolean)
      .join(" · ");
    const fc = d.pronostico.slice(0, horizon);
    const next4 = fc.slice(0, 4);
    const sum = (i: number) => next4.reduce((a, r) => a + (r[i] as number), 0);
    const peak = fc.reduce((a, r) => (r[1] > a[1] ? r : a), fc[0]);
    $("cifras").innerHTML = "";
    const cifra = (v: string, l: string) => {
      const div = document.createElement("div");
      div.className = "cifra";
      div.innerHTML = `<div class="v"></div><div class="l"></div>`;
      (div.firstChild as HTMLElement).textContent = v;
      (div.lastChild as HTMLElement).textContent = l;
      $("cifras").append(div);
    };
    cifra(nf.format(sum(1)), "atenciones esperadas en las próximas 4 semanas");
    cifra(nf.format(sum(2)), "hasta P80 en esas 4 semanas");
    cifra(`${nf.format(peak[1])}`, `semana más alta del horizonte (${fecha(peak[0])})`);

    const [c, n] = d.cobertura;
    const esc = (d as Detail & { escala?: Record<string, number> }).escala ?? {};
    const widened = Object.entries(esc).filter(([, f]) => f >= 1.05)
      .map(([q, f]) => `P${q.slice(1)} ×${f.toFixed(1).replace(".", ",")}`);
    $("bt-texto").textContent =
      `${d.ventanas} ventanas de ${d.semanas_backtest} semanas. Se usa ${d.mejor}, el de menor pérdida P80. ` +
      `El valor real quedó bajo su P80 en ${c} de ${n} semanas (${Math.round((100 * c) / n)} %; lo esperable es cerca de 80 %). ` +
      (widened.length
        ? `Por eso las bandas del pronóstico se ensancharon según ese error: ${widened.join(", ")}.`
        : "Las bandas del pronóstico no necesitaron ensancharse.");
    renderBacktestTable(d);
    const version = meta?.version;
    const fromGit = criterio !== "p80" && !hasCriterio(version);
    const install = fromGit
      ? `pip install "git+https://github.com/nicoveraz/urg-forecast-core"`
      : `pip install ${version ? `urg-forecast-core==${version}` : "urg-forecast-core"}`;
    $("cmd").textContent =
      `${install} && urg-forecast analizar ${d.c} && urg-forecast pronosticar ${d.c} -H ${HORIZON_CALC}` +
      (criterio !== "p80" ? ` --criterio ${criterio}` : "");
    $("repro-texto").textContent =
      `Esta página se calculó con ${version ? `urg-forecast-core ${version}` : "urg-forecast-core"} y los datos DEIS ` +
      `al ${meta ? fecha(meta.ultima_fecha) : "último corte"}. El comando lee la copia de datos más reciente, ` +
      "que se actualiza cada semana: con datos nuevos, tus cifras pueden diferir un poco de las de aquí. " +
      `El pronóstico se calcula siempre a ${HORIZON_CALC} semanas; la vista de 12 muestra sus primeras 12.` +
      (criterio !== "p80" ? ` Incluye --criterio ${criterio}, el que elegiste en «Qué tan confiable es».` : "") +
      (fromGit ? " Esa opción todavía no está en la versión publicada, así que el comando instala la de GitHub." : "");
    $("cmd-python").textContent = [
      "from urgencias_core import load_deis, run_forecast, weekly_series",
      "from urgencias_core.analysis.report import analysis_text",
      "",
      `df = load_deis(["${d.c}"])`,
      `semanal = weekly_series(df, "${d.c}")`,
      `print(analysis_text(semanal, "${d.n.replace(/"/g, "'")}", "${d.c}"))`,
      `res = run_forecast(semanal, ${HORIZON_CALC})`,
      "print(res.best)",
      'print(res.forecast[["timestamp", "q50", "q80", "q95"]])',
    ].join("\n");
    drawChart(d, fc, svg, tooltip, null);
    renderAnalysis(d);
    $("externa").hidden = !(d.regresores?.["Armónico"] || reg);
    renderRegToggles(d, fc);
    if (activeReg) drawChart(d, fc, svgReg, tooltipReg, activeReg);
    renderRegressor(d);
    renderNav();
  }

  // One button per visible section, numbered like the headings (CSS counters).
  function renderNav() {
    const nav = $("niveles");
    nav.innerHTML = "";
    let i = 0;
    for (const sec of document.querySelectorAll<HTMLElement>("#ficha > section.nivel")) {
      if (sec.hidden) continue;
      i += 1;
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = `${i}. ${sec.dataset.corto}`;
      b.addEventListener("click", () => sec.scrollIntoView({ behavior: "smooth", block: "start" }));
      nav.append(b);
    }
  }

  // --criterio: which model each selection criterion would pick in this backtest.
  const CRITERIOS: { k: string; label: string; col: string; desc: string }[] = [
    { k: "p80", label: "P80", col: "Pérdida P80", desc: "quedarse corto cuesta 4 veces más que pasarse" },
    { k: "p50", label: "P50", col: "Pérdida P50", desc: "quedarse corto cuesta lo mismo que pasarse" },
    { k: "p90", label: "P90", col: "Pérdida P90", desc: "quedarse corto cuesta 9 veces más" },
    { k: "p95", label: "P95", col: "Pérdida P95", desc: "quedarse corto cuesta 19 veces más" },
    { k: "media", label: "Promedio P50–P95", col: "Promedio P50–P95", desc: "el valor central y la parte alta juntos" },
    { k: "wis", label: "WIS", col: "WIS", desc: "el pronóstico completo, de P5 a P95" },
    { k: "mae", label: "MAE", col: "MAE", desc: "solo el valor central" },
  ];
  let criterio = "p80";
  // --criterio first ships in this version; with older data the command installs from GitHub.
  const CRITERIO_DESDE = [0, 5];
  const hasCriterio = (v?: string) => {
    const [a, b] = (v ?? "0.0").split(".").map(Number);
    return a > CRITERIO_DESDE[0] || (a === CRITERIO_DESDE[0] && b >= CRITERIO_DESDE[1]);
  };

  function renderBacktestTable(d: Detail) {
    const usable = CRITERIOS.filter((c) => d.backtest.every((m) => typeof m[c.k] === "number"));
    if (!usable.some((c) => c.k === criterio)) criterio = "p80";
    const box = $("criterios");
    box.hidden = usable.length <= 2; // older data: only P80 and MAE
    box.innerHTML = "";
    const lab = document.createElement("span");
    lab.className = "regs-label";
    lab.textContent = "Elegir con";
    box.append(lab);
    for (const c of usable) {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = c.label;
      b.title = c.desc;
      b.style.setProperty("--reg-color", "var(--sl-color-accent)");
      b.setAttribute("aria-pressed", String(c.k === criterio));
      b.addEventListener("click", () => { criterio = c.k; render(); });
      box.append(b);
    }
    const crit = CRITERIOS.find((c) => c.k === criterio)!;
    const val = (m: Detail["backtest"][number]) => m[crit.k] as number;
    const rows = [...d.backtest].sort((a, b) => val(a) - val(b));
    const pick = rows[0].modelo;
    const extra = crit.k !== "p80" && crit.k !== "mae";
    const bt = $<HTMLTableElement>("bt");
    bt.innerHTML = "";
    const head = document.createElement("thead");
    const hr = document.createElement("tr");
    for (const h of ["Modelo", "MAE", "MAPE %", "Pérdida P80", ...(extra ? [crit.col] : [])]) {
      const th = document.createElement("th");
      th.textContent = h;
      hr.append(th);
    }
    head.append(hr);
    const tb = document.createElement("tbody");
    const dec1 = (v: number | null | undefined) => (v == null ? "–" : v.toFixed(1).replace(".", ","));
    for (const m of rows) {
      const tr = document.createElement("tr");
      if (m.modelo === d.mejor) tr.className = "mejor";
      if (m.modelo === pick && criterio !== "p80") tr.classList.add("elegido");
      const cells = [m.modelo + (m.modelo === d.mejor ? " ✓" : ""), nf.format(m.mae), dec1(m.mape), dec1(m.p80)];
      if (extra) cells.push(dec1(val(m)));
      for (const v of cells) {
        const td = document.createElement("td");
        td.textContent = v;
        tr.append(td);
      }
      tb.append(tr);
    }
    bt.append(head, tb);
    const txt = $("criterio-texto");
    txt.hidden = box.hidden;
    txt.textContent =
      criterio === "p80"
        ? `Con P80, el criterio por defecto (${crit.desc}), gana ${pick}: el modelo de esta página (✓).`
        : `Con ${crit.label} (${crit.desc}) ganaría ${pick}. ` +
          (pick === d.mejor
            ? "Es el mismo que elige el criterio por defecto, P80."
            : `Esta página usa P80 y por eso pronostica con ${d.mejor} (✓); con --criterio ${crit.k} se pronosticaría con ${pick}.`);
  }

