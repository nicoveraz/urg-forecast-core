  function drawTypical(a: NonNullable<Detail["analisis"]>) {
    const s = document.getElementById("svg-tipico") as unknown as SVGSVGElement;
    const W = Math.max(300, Math.round(s.parentElement!.clientWidth || 760));
    const H = W < 560 ? 200 : 240, m = { t: 12, r: 10, b: 26, l: 46 };
    s.setAttribute("viewBox", `0 0 ${W} ${H}`);
    s.querySelectorAll(":scope > :not(title)").forEach((n) => n.remove());
    const rows = a.tipico;
    const vals = [...rows.flatMap((r) => [r[2], r[3]]), ...a.actual.map((r) => r[1])];
    const lo = Math.min(...vals), hi = Math.max(...vals), pad = (hi - lo) * 0.08 || 1;
    const y0 = Math.max(0, lo - pad), y1 = hi + pad;
    const X = (w: number) => m.l + ((w - 1) / 52) * (W - m.l - m.r);
    const Y = (v: number) => H - m.b - ((v - y0) / (y1 - y0)) * (H - m.t - m.b);
    const step = niceStep((y1 - y0) / 4);
    for (let v = Math.ceil(y0 / step) * step; v <= y1; v += step) {
      el("line", { x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), stroke: "var(--sl-color-hairline)" }, s);
      el("text", { x: m.l - 6, y: Y(v) + 4, "text-anchor": "end" }, s).textContent = nf.format(v);
    }
    // Month labels at the first week whose closing Monday falls in each month (2026 calendar).
    let prev = -1;
    for (let w = 1; w <= 53; w++) {
      const monday = new Date(Date.UTC(2025, 11, 29 + 7 * (w - 1)));
      const mo = monday.getUTCMonth();
      if (mo !== prev && monday.getUTCFullYear() === 2026 && (W >= 560 || mo % 3 === 0))
        el("text", { x: X(w), y: H - 8, "text-anchor": "middle" }, s).textContent = MESES[mo];
      prev = mo;
    }
    const path = (pts: [number, number][]) => pts.map(([w, v], i) => `${i ? "L" : "M"}${X(w).toFixed(1)},${Y(v).toFixed(1)}`).join("");
    el("path", { d: path(rows.map((r) => [r[0], r[2]])) + rows.slice().reverse().map((r) => `L${X(r[0]).toFixed(1)},${Y(r[3]).toFixed(1)}`).join("") + "Z",
      fill: "var(--sl-color-gray-3)", "fill-opacity": 0.22 }, s);
    el("path", { d: path(rows.map((r) => [r[0], r[1]])), fill: "none", stroke: "var(--sl-color-gray-2)", "stroke-width": 2 }, s);
    el("path", { d: path(a.actual), fill: "none", stroke: "var(--sl-color-accent)", "stroke-width": 2.4, "stroke-linejoin": "round" }, s);
    for (const [w, v] of a.actual) el("circle", { cx: X(w), cy: Y(v), r: 2.6, fill: "var(--sl-color-accent)" }, s);
  }

  const REG_COLOR: Record<string, string> = {
    ArmónicoFeriados: "var(--sl-color-green)",
    ArmónicoFluNet: "var(--sl-color-blue)",
    ArmónicoFluNetProy: "var(--sl-color-purple)",
  };
  const REG_NAME: Record<string, string> = {
    ArmónicoFeriados: "con feriados",
    ArmónicoFluNet: "con virus respiratorios",
    ArmónicoFluNetProy: "con virus proyectados",
  };
  const OTHER_COLORS = ["var(--sl-color-orange)", "var(--sl-color-red)", "var(--sl-color-gray-3)"];
  const candColor = (i: number) => {
    const m = reg?.candidatos[i] ?? "";
    return REG_COLOR[m] ?? OTHER_COLORS[i % OTHER_COLORS.length];
  };

  const VEREDICTO: Record<string, string> = { mejora: "mejora", empeora: "empeora", "sin diferencia clara": "neutro" };
  const pct = (v: number | null) =>
    v == null ? "–" : `${v > 0 ? "+" : v < 0 ? "−" : ""}${Math.abs(v).toFixed(1).replace(".", ",")} %`;

  function renderRegressor(d: Detail) {
