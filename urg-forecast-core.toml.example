# Example configuration for the urg-forecast-core reference server.
#
# Copy to ``urg-forecast-core.toml`` in the project root and edit to point at
# your own visit-level parquet. If this file is absent — or the [data].parquet
# line below is omitted — the server runs against the packaged synthetic
# fixture bundled inside the installed package.

[data]
# Path to YOUR visit-level parquet. Must match the loader schema (see
# urgencias_core/data/loader.py for required columns). Omit this line to use
# the packaged synthetic fixture instead.
parquet = "/absolute/path/to/your/ed_visits.parquet"

[forecast]
# Forecaster: "seasonal_naive" or "lgb_quantile".
forecaster = "seasonal_naive"
# Column of the hourly time series to forecast.
target = "arrivals"
# Hours ahead to produce.
horizon_hours = 168

[simulation]
horizon_hours = 24
n_sims = 200
current_census = 0
start_hour = 12
# arrivals_per_hour = 5.0   # omit to use the recent history mean
